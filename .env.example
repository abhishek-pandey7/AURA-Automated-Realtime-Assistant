# AURA Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# InferX (or any OpenAI-compatible) endpoint
INFERX_BASE_URL=https://your-litellm-proxy.example.com/v1
INFERX_API_KEY=sk-your-api-key-here
INFERX_MODEL=gemma-4-31b

# Set to "false" to disable confirmation prompts (use with caution)
AURA_SAFE_MODE=true

# Optional
# AURA_HOME=~/.aura                 # sessions, learned tools, Google credentials, form profile
# AURA_CHROME_PROFILE=               # Chrome profile for the browser tool (defaults to your OS's)
# AURA_USER_NAME=                    # name used in the spoken "task completed" message
